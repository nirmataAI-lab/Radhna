{
  "name": "restaurant-management-system",
  "version": "1.0.0",
  "description": "Restaurant Management System - A full-stack restaurant ordering and kitchen display system",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "install:all": "npm install",
    "db:generate": "cd database && npx prisma generate",
    "db:migrate": "cd database && npx prisma migrate dev --name init",
    "db:seed": "cd database && ts-node seed/index.ts",
    "db:push": "cd database && npx prisma db push",
    "db:studio": "cd database && npx prisma studio",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "backend:dev": "cd services/backend-api && npm run start:dev",
    "backend:build": "cd services/backend-api && npm run build",
    "customer:dev": "cd apps/customer-web && npm run dev",
    "admin:dev": "cd apps/admin-web && npm run dev",
    "chief:dev": "cd apps/chief-web && npm run dev",
    "dev": "concurrently \"npm run backend:dev\" \"npm run customer:dev\" \"npm run admin:dev\" \"npm run chief:dev\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "npm run docker:up && sleep 3 && npm run db:setup",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["restaurant", "ordering", "kds", "management"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2"
  }
}
