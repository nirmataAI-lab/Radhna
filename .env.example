# -----------------------------------------------------------------------------
# Root Environment Configuration Template
# -----------------------------------------------------------------------------

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/restaurant_db?schema=public"

# Redis Cache & BullMQ Queue
REDIS_HOST="localhost"
REDIS_PORT=6379

# NestJS Backend API
PORT=3000
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production"
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:8080"

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"

# Twilio SMS / WhatsApp (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Nodemailer Email Transporter (Optional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""

# Frontend Applications
VITE_API_URL="http://localhost:3000/api"
VITE_WS_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
