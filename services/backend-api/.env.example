# Database (Supabase Postgres — hybrid setup)
# Use the pooler (6543) at runtime for the API, and the session pooler (5432) for migrations/seed.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# JWT (REQUIRED - change this in production)
JWT_SECRET=your-super-secret-key-change-in-production

# Server
PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Razorpay (required for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP (optional - email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@radhnacuisine.com

# Twilio (optional - SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App URLs
CUSTOMER_APP_URL=http://localhost:3001
